#!/usr/bin/env bash
# Cold-environment tests for bin/ensure-uv: run it the way a fresh machine
# does — stripped PATH (base OS tools only), empty HOME, no uv, no brew.
#
# Default run needs the network once (~20MB, the pinned uv asset); everything
# else is offline. `--linux-docker` additionally runs the fresh + corrupted
# cases inside cold ubuntu containers (arm64 + amd64), opt-in because it
# pulls images and apt-installs curl.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COLD_PATH="/usr/bin:/bin:/usr/sbin:/sbin"
PASS=0

run_cold() { # HOME, then ensure-uv args
  local home="$1"; shift
  env -i HOME="$home" PATH="$COLD_PATH" sh "$ROOT/bin/ensure-uv" "$@"
}

ok() { PASS=$((PASS + 1)); echo "ok  $1"; }
fail() { echo "FAIL $1" >&2; exit 1; }

# --- 1. fresh cold install: download, verify, stamp, self-test ---------------
H1="$(mktemp -d)"
out="$(run_cold "$H1")" || fail "fresh install exited nonzero"
[[ "$out" == "$H1/.powerpacks/bin/uv" ]] || fail "fresh install resolved '$out', expected the vendored path"
[[ -x "$out" ]] || fail "vendored uv is not executable"
[[ "$(cat "$H1/.powerpacks/bin/.uv-version")" != "" ]] || fail "version stamp missing"
env -i HOME="$H1" PATH="$COLD_PATH" "$out" --version >/dev/null || fail "vendored uv does not run cold"
ok "fresh cold install vendors uv"

# --- 2. idempotent rerun: no re-download, same path --------------------------
before="$(stat -f %m "$out" 2>/dev/null || stat -c %Y "$out")"
out2="$(run_cold "$H1")" || fail "rerun exited nonzero"
after="$(stat -f %m "$out" 2>/dev/null || stat -c %Y "$out")"
[[ "$out2" == "$out" && "$before" == "$after" ]] || fail "rerun re-downloaded or moved the binary"
ok "rerun is a no-op"

# --- 3. probe mode never downloads -------------------------------------------
H3="$(mktemp -d)"
if run_cold "$H3" --no-install >/dev/null 2>"$H3/err"; then
  fail "--no-install succeeded on an empty machine"
fi
grep -q "not downloading" "$H3/err" || fail "--no-install error does not say it is probe mode"
[[ ! -e "$H3/.powerpacks/bin/uv" ]] || fail "--no-install downloaded anyway"
ok "probe mode reports without downloading"

# --- 4. an existing uv on PATH is preferred over a download ------------------
H4="$(mktemp -d)"
mkdir -p "$H4/fakebin"
printf '#!/bin/sh\necho uv-stub\n' > "$H4/fakebin/uv"
chmod +x "$H4/fakebin/uv"
out4="$(env -i HOME="$H4" PATH="$H4/fakebin:$COLD_PATH" sh "$ROOT/bin/ensure-uv")" || fail "PATH passthrough exited nonzero"
[[ "$out4" == "$H4/fakebin/uv" ]] || fail "resolved '$out4' instead of the PATH uv"
[[ ! -e "$H4/.powerpacks/bin/uv" ]] || fail "downloaded despite a PATH uv"
ok "PATH uv passes through untouched"

# --- 5. corrupted asset: verification fails BEFORE trust, file deleted -------
H5="$(mktemp -d)"
mkdir -p "$H5/rel/0.12.1"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64|Darwin-arm64e) asset="uv-aarch64-apple-darwin" ;;
  Darwin-x86_64)              asset="uv-x86_64-apple-darwin" ;;
  Linux-aarch64|Linux-arm64)  asset="uv-aarch64-unknown-linux-gnu" ;;
  Linux-x86_64|Linux-amd64)   asset="uv-x86_64-unknown-linux-gnu" ;;
  *) fail "unsupported test platform" ;;
esac
echo "tampered bytes" > "$H5/rel/0.12.1/$asset.tar.gz"
if env -i HOME="$H5" PATH="$COLD_PATH" POWERPACKS_UV_RELEASE_BASE="file://$H5/rel" \
    sh "$ROOT/bin/ensure-uv" >/dev/null 2>"$H5/err"; then
  fail "tampered asset was accepted"
fi
grep -q "sha256 verification" "$H5/err" || fail "corruption error does not mention sha256"
[[ ! -e "$H5/.powerpacks/bin/uv" && ! -e "$H5/.powerpacks/bin/uv.tar.gz.download" ]] \
  || fail "tampered download was not deleted"
ok "tampered asset is rejected and deleted"

rm -rf "$H1" "$H3" "$H4" "$H5"

# --- optional: cold Linux containers -----------------------------------------
if [[ "${1:-}" == "--linux-docker" ]]; then
  command -v docker >/dev/null 2>&1 || fail "--linux-docker requires docker"
  for platform in linux/arm64 linux/amd64; do
    docker run --rm --platform "$platform" -v "$ROOT/bin/ensure-uv:/ensure-uv:ro" ubuntu:24.04 bash -ec '
      apt-get update -qq >/dev/null && apt-get install -y -qq curl ca-certificates >/dev/null
      out="$(sh /ensure-uv)"
      test -x "$out"
      "$out" --version >/dev/null
      echo "ok  cold container install ($(uname -m))"
    ' || fail "cold container install failed on $platform"
    PASS=$((PASS + 1))
  done
fi

echo "test-cold-bootstrap: $PASS checks passed"
