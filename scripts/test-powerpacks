#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

UV_BIN="${UV_BIN:-}"
if [[ -z "$UV_BIN" ]]; then
  if ! UV_BIN="$("$ROOT/bin/ensure-uv" --no-install)"; then
    echo "uv is required; run bin/setup-python first" >&2
    exit 127
  fi
fi

# The repository gate is discover-based because Deep Context tests import their
# shared synthetic helper from the discovered tests directory.
"$UV_BIN" run --project . python -m unittest discover -s tests -v
"$UV_BIN" run --project . python scripts/audit_deep_context_sqlite.py
