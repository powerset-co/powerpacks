#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

UV_BIN="${UV_BIN:-}"
if [[ -z "$UV_BIN" ]]; then
  if ! UV_BIN="$("$ROOT/bin/ensure-uv" --no-install)"; then
    echo "uv is required; run bin/setup-python first" >&2
    exit 127
  fi
fi

# Focused offline baseline gate. Source-specific integration suites use local
# fixtures and fake providers; they do not read user data or make network calls.
# Deep Context tests import their synthetic helper from the tests directory, so
# that directory stays on PYTHONPATH.
export PYTHONPATH="$ROOT/tests${PYTHONPATH:+:$PYTHONPATH}"
# Search fixtures load .env; keep their uncached department checks offline.
export TYPESAFE_API_KEY=""

# Baseline suites, then the SQLite Deep Context and share rewrite suites.
exec "$UV_BIN" run --project . python -m unittest \
  tests.test_bootstrap \
  tests.test_installed_skill_context \
  tests.test_skill_spec \
  tests.test_install_status \
  tests.test_install_onboard \
  tests.test_install_tools \
  tests.test_onboarding_workflow \
  tests.test_msgvault_consent \
  tests.test_msgvault_setup \
  tests.test_refresh_tasks \
  tests.test_refresh_tasks_api \
  tests.test_refresh_sources \
  tests.test_install_index_progress \
  tests.test_install_pipeline \
  tests.test_deep_context_v2_enrich_confirm \
  tests.test_deep_context_v2_fixes \
  tests.test_install_coordinator \
  tests.test_candidate_judge_evidence \
  tests.test_candidate_judges \
  tests.test_capability_contract \
  tests.test_clean_job_description \
  tests.test_company_context \
  tests.test_core_layout \
  tests.test_cross_encoder_client \
  tests.test_cross_encoder_search \
  tests.test_cross_encoder_warmup \
  tests.test_deep_search_catalog \
  tests.test_deep_search_results_web \
  tests.test_discover \
  tests.test_enrich_primitives \
  tests.test_extract_imessage_failures \
  tests.test_fetch_job_posting \
  tests.test_gmail_import \
  tests.test_import_contacts_quality \
  tests.test_import_status \
  tests.test_index_contacts_pipeline \
  tests.test_ingestion_messages_contract \
  tests.test_interaction_counts \
  tests.test_jd_query \
  tests.test_jev_client \
  tests.test_jev_model \
  tests.test_jev_pipeline \
  tests.test_job_location \
  tests.test_llm_rerank_candidates \
  tests.test_local_duckdb_backend \
  tests.test_local_search_pipeline \
  tests.test_location_normalization \
  tests.test_mcp_install \
  tests.test_messages_import_selection \
  tests.test_messages_pack \
  tests.test_people_identity \
  tests.test_pipeline_contract \
  tests.test_pipeline_visualize \
  tests.test_preview_search_labels \
  tests.test_pull_runtime_keys \
  tests.test_search_harness \
  tests.test_team_department \
  tests.test_team_similarity \
  tests.test_terra_capability \
  tests.test_terra_pipeline \
  tests.test_update_powerpacks \
  tests.test_usage_capture \
  tests.test_wacli_payloads \
  tests.test_whatsapp_wacli \
  tests.test_role_address \
  tests.test_profile_transient_failure \
  tests.test_ingestion_jsonio \
  tests.test_logbook \
  tests.test_app_routes \
  tests.test_enrich_people \
  tests.test_icons \
  tests.test_linkedin_import \
  tests.test_local_searches_browser \
  tests.test_merge_people \
  tests.test_search_json_contract \
  tests.test_validate_search_index \
  tests.test_indexing_scaffold \
  tests.test_merge_people_source_identity \
