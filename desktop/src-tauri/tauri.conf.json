{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Powerpacks",
  "version": "0.1.0",
  "identifier": "co.powerset.powerpacks",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Search your network and build context about people",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../bin/bootstrap": "bootstrap"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
