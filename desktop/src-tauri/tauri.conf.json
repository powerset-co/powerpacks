{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Powerpacks",
  "version": "3.28.1",
  "identifier": "co.powerset.powerpacks",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "Search your network and build context about people",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/powerpacks.tar.gz": "powerpacks.tar.gz",
      "resources/powerpacks.version": "powerpacks.version"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 180 },
        "applicationFolderPosition": { "x": 480, "y": 180 }
      }
    },
    "externalBin": [
      "binaries/uv",
      "binaries/node",
      "binaries/codex",
      "binaries/codex-code-mode-host",
      "binaries/rg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/powerset-co/powerpacks/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNjdDNTUxNTI4MUMzODAKUldTQXc0RlNVY1Zub09KMWlBdHk3bDIxdFNOamlUTWU4VGwyOEsxUlYvLytZMnl0OWdmdUNxeWoK"
    }
  }
}
