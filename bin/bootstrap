#!/usr/bin/env bash
# Install the runtime, then resume the single account-to-search workflow.
#
# The coding agent (Claude Code, Codex, Pi) runs this on the user's behalf. It
# asks nothing and decides nothing for the agent: the LAST line names the
# outcome. The agent handles routine recovery and relays only human actions.
#
#   DONE: ...        installed; continue with the user's ask
#   NEEDS YOU: ...   a step needs the human (a click, a password); show the line
#                    live commands resume after the action; exited ones need recovery
#   STOP: ...        wrong place to run this; show the line, do not continue
#   FAILED: ...      something broke; show the line
#
# Safe to run again: every step is skipped once done.
#
#   bootstrap [--harness codex|claude-code|pi|all] [--powerset] [--port PORT]
#
#   --harness   which agent's skills folder to install into; default: every one
#               found on this Mac (both Claude Code and Codex when none is found)
#   --powerset  connect the account, check hosted search, then import contacts
#
# Exit codes: 0 done; 3 STOP; 10 NEEDS YOU; 1 FAILED; 2 bad arguments.
#
# Created: 2026-09-30
# Changelog:
#   2026-09-30: created. Replaces the six-step prose in install-powerpacks/SKILL.md
#     so a small model can install by running one command and reading one line.
set -euo pipefail

REPO_URL="${POWERPACKS_REPO_URL:-https://github.com/powerset-co/powerpacks.git}"
DEFAULT_ROOT="$HOME/powerpacks"

harness="auto"
powerset=0
port=8765
source_args=()
bootstrap_args=("$@")
retry_command="bin/bootstrap"
if [[ $# -gt 0 ]]; then
  printf -v retry_args ' %q' "$@"
  retry_command+="$retry_args"
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness) harness="${2:-}"; shift 2 ;;
    --powerset) powerset=1; shift ;;
    --port) port="${2:-}"; shift 2 ;;
    --source|--skip-source|--gmail-email|--sync-after|--wacli-store)
      source_args+=("$1" "${2:?Missing value for $1}"); shift 2 ;;
    --approve-spend) source_args+=("$1" "${2:?Missing value for $1}"); shift 2 ;;
    --refresh|--approve-upload) source_args+=("$1"); shift ;;
    *)
      echo "usage: bootstrap [--harness codex|claude-code|pi|all] [--powerset] [--port PORT]" >&2
      exit 2
      ;;
  esac
done

log=""
progress_started=0
terminal_status=""
say() { echo "powerpacks: $*"; [[ -z "$log" ]] || echo "powerpacks: $*" >>"$log"; }
progress() {
  (cd "$root" && "$POWERPACKS_INSTALL_PYTHON" -m packs.powerset.primitives.install.status write \
    --root "$root" --step "$1" --status "$2" --message "$3" --pid "$$" \
    --retry-command "$retry_command") >/dev/null
}
finish_progress() {
  terminal_status="$1"
  [[ "$progress_started" == 1 ]] || return 0
  local step
  step="$("$POWERPACKS_INSTALL_PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1]))["step"])' "$root/.powerpacks/install/manifest.json")"
  retry_command="$("$POWERPACKS_INSTALL_PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1]))["retry_command"])' "$root/.powerpacks/install/manifest.json")"
  progress "$step" "$1" "$2"
}
needs_you() { finish_progress waiting "$*"; echo "NEEDS YOU: $*"; exit 10; }
failed() { finish_progress failed "$*"; echo "FAILED: $*"; exit 1; }
on_exit() {
  local code=$?
  if [[ "$progress_started" == 1 && -z "$terminal_status" ]]; then
    finish_progress failed "Installation stopped. Ask the agent to check $log and rerun $retry_command." || true
    echo "FAILED: Installation stopped. Check $log and run this again."
    [[ "$code" != 0 ]] || code=1
  fi
  exit "$code"
}
trap on_exit EXIT
trap 'finish_progress waiting "Setup paused. I can resume it from here."; echo "NEEDS YOU: Setup paused. I can resume it from here."; exit 130' INT
trap 'finish_progress waiting "Setup paused. I can resume it from here."; echo "NEEDS YOU: Setup paused. I can resume it from here."; exit 143' TERM

# 1. This must be a local session on the user's own Mac: the skills read mail
#    and messages from this machine. A cloud session or a Linux sandbox is not it.
if [[ "$(uname -s)" != Darwin || ! -d "$HOME/Library" || "${CLAUDE_CODE_REMOTE:-}" == true ]]; then
  echo "STOP: This is not a session on the user's own Mac, so Powerpacks cannot be installed from here. Tell the user: open Terminal on your Mac, start Claude Code or Codex there, and paste the same sentence."
  exit 3
fi

# 2. git comes with Apple's command line tools. Missing means a first-run Mac;
#    the install is a dialog only the human can click.
if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install >/dev/null 2>&1 || true
  needs_you "A macOS window is asking to install the command line developer tools. Click Install and wait for it to finish (a few minutes). Then tell me and I'll continue."
fi

# 3. The repo: reuse a checkout if one exists, otherwise clone and pin it to the
#    newest release (installs follow releases, not the tip of main).
root=""
fresh_clone=0
for candidate in "${POWERPACKS_REPO_ROOT:-}" "$DEFAULT_ROOT" "$HOME/workspace/powerpacks"; do
  if [[ -n "$candidate" && -x "$candidate/install.sh" && -d "$candidate/packs" ]]; then
    root="$candidate"
    break
  fi
done
if [[ -z "$root" ]]; then
  say "downloading Powerpacks to $DEFAULT_ROOT"
  git clone --quiet "$REPO_URL" "$DEFAULT_ROOT" || failed "could not download Powerpacks from $REPO_URL. Check the internet connection and run this again."
  "$DEFAULT_ROOT/bin/powerpacks-channel" --checkout "$DEFAULT_ROOT" >/dev/null || failed "downloaded Powerpacks but could not pick a release. Run this again."
  root="$DEFAULT_ROOT"
  fresh_clone=1
fi
root="$(cd "$root" && pwd)"
bootstrap_source="${BASH_SOURCE[0]:-}"
if [[ -n "$bootstrap_source" ]]; then
  bootstrap_source="$(cd "$(dirname "$bootstrap_source")" && pwd)/$(basename "$bootstrap_source")"
fi
# The selected release owns installation, including its available modules.
if [[ "$bootstrap_source" != "$root/bin/bootstrap" ]]; then
  if [[ "$fresh_clone" == 0 ]] && git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    # The downloaded launcher must not hand off to an old installed launcher.
    # Keep local work intact; the channel helper switches without --force.
    if ! git -C "$root" diff --quiet || ! git -C "$root" diff --cached --quiet; then
      failed "Local code changes in $root need to be saved before updating. Ask me to inspect git status and preserve them, then retry."
    fi
    say "checking for the current Powerpacks release"
    if ! git -C "$root" fetch --quiet --tags origin; then
      origin="$(git -C "$root" remote get-url origin)"
      case "$origin" in
        git@github.com:powerset-co/powerpacks.git|ssh://git@github.com/powerset-co/powerpacks.git)
          git -C "$root" fetch --quiet --tags https://github.com/powerset-co/powerpacks.git '+refs/heads/*:refs/remotes/origin/*' \
            || failed "Could not download the Powerpacks update over HTTPS. Check the connection and retry."
          ;;
        *) failed "Could not check for a Powerpacks update. Check the connection to the checkout's origin and retry." ;;
      esac
    fi
    selection="$("$root/bin/powerpacks-channel" "$root")" || failed "Could not resolve the Powerpacks release. Check the Git error above and retry."
    selected_branch=""
    while IFS='=' read -r name value; do
      [[ "$name" != branch ]] || selected_branch="$value"
    done <<<"$selection"
    if git -C "$root" rev-parse --verify --quiet "$selected_branch" >/dev/null && \
       [[ -z "$(git -C "$root" branch -r --contains "$selected_branch")" && \
          -z "$(git -C "$root" tag --points-at "$selected_branch" --list 'powerpacks-v*')" ]]; then
      failed "The $selected_branch branch has local commits. Ask me to preserve that work before updating, then retry."
    fi
    "$root/bin/powerpacks-channel" --checkout "$root" >/dev/null \
      || failed "Could not select the Powerpacks release. Ask me to inspect the Git error above and preserve any local files before retrying."
  fi
  exec "$root/bin/bootstrap" ${bootstrap_args[@]+"${bootstrap_args[@]}"}
fi
say "repo: $root"

# The page needs only Python itself; project packages install after it opens.
export POWERPACKS_INSTALL_PID="$$"
if ! POWERPACKS_INSTALL_PYTHON="$(command -v python3)"; then
  failed "Python is not available. Finish installing the macOS command line tools and run this again."
fi
export POWERPACKS_INSTALL_PYTHON
export POWERPACKS_INSTALL_RETRY_COMMAND="$retry_command"
mkdir -p "$root/.powerpacks/install"
log="$root/.powerpacks/install/install.log"
say "starting installation"
progress runtime running "Preparing your Mac"
progress_started=1
if ! UV_BIN="$("$root/bin/ensure-uv" 2>>"$log")"; then
  tail -n 20 "$log" >&2
  failed "Python could not be prepared. Check $log and run this again."
fi
python_version="${POWERPACKS_PYTHON_VERSION:-3.12}"
if ! "$UV_BIN" python install "$python_version" >>"$log" 2>&1; then
  tail -n 20 "$log" >&2
  failed "Python could not be installed. Check $log and run this again."
fi
if ! runtime_python="$("$UV_BIN" python find "$python_version" 2>>"$log")"; then
  failed "Python could not be located. Check $log and run this again."
fi
POWERPACKS_INSTALL_PYTHON="$runtime_python"
if ! page="$(cd "$root" && "$POWERPACKS_INSTALL_PYTHON" -m packs.ingestion.primitives.deep_context.review.cli start --stage install --port "$port" 2>>"$log")"; then
  tail -n 20 "$log" >&2
  failed "The Powerpacks page could not start. Check $log and run this again."
fi
url="$("$POWERPACKS_INSTALL_PYTHON" -c 'import json,sys; print(json.load(sys.stdin)["url"])' <<<"$page")"
echo "STATUS PAGE: $url"

# 4. Which agents live on this Mac. None found (a brand-new machine) installs
#    for both, so whichever the user opens next has the skills.
found=()
if [[ -n "${CLAUDECODE:-}" || -d "$HOME/.claude" ]] || command -v claude >/dev/null 2>&1; then found+=(claude-code); fi
if [[ -d "$HOME/.codex" ]] || command -v codex >/dev/null 2>&1; then found+=(codex); fi
if [[ -d "$HOME/.pi/agent" ]]; then found+=(pi); fi
case "$harness" in
  auto) harnesses=("${found[@]:-}"); [[ -n "${harnesses[0]}" ]] || harnesses=(claude-code codex) ;;
  all) harnesses=(claude-code codex pi) ;;
  codex|claude-code|pi) harnesses=("$harness") ;;
  *) echo "usage: --harness codex|claude-code|pi|all" >&2; exit 2 ;;
esac

if ! "$root/bin/setup-python" >>"$log" 2>&1; then
  tail -n 20 "$log" >&2
  failed "Powerpacks could not finish installing what it needs. Check $log and run this again."
fi
progress dependencies completed "Powerpacks dependencies are ready"
progress skills running "Adding Powerpacks skills"
for h in "${harnesses[@]}"; do
  say "installing skills for $h"
  if ! POWERPACKS_SKIP_UV_SYNC=1 "$root/install.sh" "$h" >>"$log" 2>&1; then
    tail -n 20 "$log" >&2
    failed "installing the skills for $h did not finish. Check $log; fix the error and run this again."
  fi
done

progress skills completed "Powerpacks skills are installed"

# 5. A Powerset user gets the hosted config; an existing .env is theirs and is
#    never touched.
if [[ "$powerset" == 1 && ! -f "$root/.env" ]]; then
  cp "$root/packs/powerset/templates/env.powerset.example" "$root/.env" 2>>"$log"
  chmod 600 "$root/.env" 2>>"$log"
  say "created $root/.env from the Powerset template"
fi

if [[ "$powerset" == 1 ]]; then
  onboard_args=()
  for h in "${harnesses[@]}"; do onboard_args+=(--harness "$h"); done
  code=0
  # Python calls the existing login, provisioning, and connection primitives
  # in-process. Keep its final line visible and preserve its waiting state.
  # Onboarding imports the whole pipeline; only the project venv has its dependencies.
  (cd "$root" && "$root/.venv/bin/python" -m packs.powerset.primitives.install.onboard \
    --root "$root" --port "$port" "${onboard_args[@]}" ${source_args[@]+"${source_args[@]}"}) \
    2> >(tee -a "$log" >&2) || code=$?
  case "$code" in
    0) terminal_status=completed ;;
    10) terminal_status=waiting ;;
    130|143) finish_progress waiting "Setup paused. I can resume it from here." ;;
    *)
      saved_status="$("$POWERPACKS_INSTALL_PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1]))["status"])' "$root/.powerpacks/install/manifest.json")"
      if [[ "$saved_status" != failed ]]; then
        finish_progress failed "Setup stopped. Ask me in chat to check $log and retry."
      fi
      terminal_status=failed
      ;;
  esac
  if [[ "$code" == 0 || "$code" == 10 ]]; then
    if ! (cd "$root" && "$POWERPACKS_INSTALL_PYTHON" "$root/bin/agent-bootstrap" --json) >>"$log" 2>&1; then
      echo "powerpacks: user context could not be refreshed" >>"$log"
    fi
  fi
  exit "$code"
fi

for step in account credentials connection network; do
  progress "$step" skipped "Skipped for this local-only installation"
done
progress ready completed "Powerpacks skills are installed. No account was connected."
terminal_status=completed
echo "DONE: Powerpacks skills are installed for ${harnesses[*]} from $root. No account was connected. Continue with the user's request."
