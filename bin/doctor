#!/usr/bin/env bash
# Convenience wrapper so agents/users don't have to type
# packs/powerset/primitives/doctor/doctor.py.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if UV_BIN="$("$ROOT/bin/ensure-uv" --no-install 2>/dev/null)"; then
  exec "$UV_BIN" run --project "$ROOT" python "$ROOT/packs/powerset/primitives/doctor/doctor.py" "$@"
fi
exec python3 "$ROOT/packs/powerset/primitives/doctor/doctor.py" "$@"
