#!/usr/bin/env bash
# Install the pinned Python runtime and locked project dependencies.
#
# uv acquisition is delegated to bin/ensure-uv (vendored, sha256-pinned
# bootstrap that needs no Homebrew, git, or Xcode CLT); this script never
# installs OS packages. POWERPACKS_AUTO_INSTALL=0 forbids the uv download
# (probe-only resolution); POWERPACKS_SKIP_UV_SYNC=1 skips everything.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_VERSION="${POWERPACKS_PYTHON_VERSION:-3.12}"
AUTO_INSTALL="${POWERPACKS_AUTO_INSTALL:-1}"

if [[ "${POWERPACKS_SKIP_UV_SYNC:-}" == "1" ]]; then
  echo "setup-python: skipped uv sync (POWERPACKS_SKIP_UV_SYNC=1)"
  exit 0
fi

ensure_args=()
if [[ "$AUTO_INSTALL" != "1" ]]; then
  ensure_args+=(--no-install)
fi
if ! UV_BIN="$("$ROOT/bin/ensure-uv" ${ensure_args[@]+"${ensure_args[@]}"})"; then
  echo "error: uv is required for Powerpacks Python dependencies and could not be resolved." >&2
  echo "Follow the ensure-uv fix printed above, then rerun bin/setup-python." >&2
  exit 1
fi

"$UV_BIN" python install "$PYTHON_VERSION"

sync_args=(sync --project "$ROOT" --python "$PYTHON_VERSION")
if [[ -f "$ROOT/uv.lock" ]]; then
  sync_args+=(--frozen)
fi
if ! "$UV_BIN" "${sync_args[@]}"; then
  echo "error: uv sync failed; .venv may be incomplete and primitives will fail with missing packages." >&2
  echo "Common causes: an interrupted network connection (rerun), TLS interception (rerun with UV_NATIVE_TLS=1)," >&2
  echo "or a corrupted cache ('$UV_BIN cache clean', then rerun bin/setup-python)." >&2
  exit 1
fi

echo "setup-python: Python $PYTHON_VERSION dependencies ready ($ROOT; uv: $UV_BIN)"
