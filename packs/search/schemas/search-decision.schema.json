{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerpacks/schemas/search-decision.schema.json",
  "title": "SearchRoute",
  "description": "The canonical $search route recorded to decision.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "profile", "backend", "reason"],
  "properties": {
    "target": {
      "type": "string",
      "enum": ["engine", "sql", "contacts"]
    },
    "profile": {"type": ["string", "null"], "enum": ["lookup", "gtm", "recruiting", null]},
    "backend": {
      "type": ["string", "null"],
      "enum": ["powerset", "local", null]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {"if": {"properties": {"target": {"const": "engine"}}}, "then": {"properties": {"profile": {"enum": ["lookup", "gtm", "recruiting"]}, "backend": {"enum": ["local", "powerset"]}}}},
    {"if": {"properties": {"target": {"enum": ["sql", "contacts"]}}}, "then": {"properties": {"profile": {"const": null}, "backend": {"const": null}}}}
  ]
}
