{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reflect-hard-filter-validation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_hash", "corpus_snapshot_hash", "reviewed_count", "violation_count", "violations", "producer", "generated_at"],
  "properties": {
    "schema_version": {"const": "reflect.hard_filter_validation.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "case_hash": {"$ref": "#/$defs/hash"},
    "corpus_snapshot_hash": {"$ref": "#/$defs/hash"},
    "reviewed_count": {"type": "integer", "minimum": 0},
    "violation_count": {"type": "integer", "minimum": 0},
    "violations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["person_id", "reason_code"],
        "properties": {
          "person_id": {"type": "string", "minLength": 1},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "producer": {"enum": ["synthetic_contract_fixture", "typed_runner"]},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
