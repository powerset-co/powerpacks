{
  "name": "summaries",
  "type": "turbopuffer_namespace",
  "version": "2026-04-29",
  "namespace": "aleph_summaries_v1",
  "document_grain": "person_summary",
  "person_identity": {
    "source": "row_id"
  },
  "description": "Person-level summary namespace used as a bounded retrieval lane and explicit tech-skill prefilter.",
  "vector": {"dimension": 1536, "distance_metric": "cosine_distance"},
  "attributes": [
    {"name": "id", "type": "string", "notes": "Base person id."},
    {"name": "person_id", "type": "string", "notes": "Alias for id."},
    {"name": "base_id", "type": "string", "notes": "Alias for id."},
    {"name": "summary", "type": "string"},
    {"name": "phrase_tokens", "type": "string[]"},
    {"name": "word_tokens", "type": "string[]"},
    {"name": "summary_tokens", "type": "string[]"},
    {"name": "tech_skills", "type": "string[]"},
    {"name": "allowed_operator_ids", "type": "string[]"}
  ],
  "filters": [
    {"field": "id", "operators": ["In"], "value_type": "string[]"},
    {"field": "tech_skills", "operators": ["ContainsAny"], "value_type": "string[]"},
    {"field": "allowed_operator_ids", "operators": ["ContainsAny"], "value_type": "string[]"}
  ],
  "rules": [
    "Do not require this namespace for core role search.",
    "Summary matches are person-grain and never create matched position ids.",
    "Apply operator and supported hard-filter eligibility before top-k retrieval."
  ]
}
