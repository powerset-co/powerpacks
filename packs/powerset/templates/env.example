# Powerset hosted API/MCP/Auth0 config. Leave blank for OSS/local-only use;
# unset, primitives default to the hosted API in env.powerset.example.
POWERSET_API_URL=
POWERPACKS_MCP_URL=
POWERPACKS_AUTH0_DOMAIN=
POWERPACKS_AUTH0_CLIENT_ID=
POWERPACKS_AUTH0_AUDIENCE=
POWERPACKS_AUTH0_SCOPES=openid profile email offline_access

# Powerpacks connector env
DATABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PARALLEL_API_KEY=
POWERPACKS_DEFAULT_SET_ID=
# Legacy alias also supported by search primitives.
POWERSET_DEFAULT_SET_ID=
POWERSET_API_KEY=
POWERSET_API_KEY_BACKUP=
RAPIDAPI_TWITTER_KEY=
# Twitter241-only legacy fallback.
RAPIDAPI_KEY=
