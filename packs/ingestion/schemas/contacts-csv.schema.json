{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Powerpacks messages contacts CSV row",
  "type": "object",
  "required": [
    "phone",
    "name"
  ],
  "properties": {
    "phone": {
      "type": "string",
      "description": "Phone number or iMessage email handle."
    },
    "name": {
      "type": "string",
      "description": "Contact full/display name."
    },
    "source": {
      "type": "string",
      "description": "imessage, whatsapp, phone, or comma-separated sources."
    },
    "is_in_group_chats": {
      "type": "string",
      "description": "true/false style boolean."
    },
    "group_names": {
      "type": "string",
      "description": "Group names joined with ' | '."
    },
    "message_count": {
      "type": "string",
      "description": "Total non-negative integer message count across known message sources."
    },
    "imessage_message_count": {
      "type": "string",
      "description": "iMessage/SMS message count if known."
    },
    "whatsapp_message_count": {
      "type": "string",
      "description": "WhatsApp direct-chat message count if known."
    },
    "last_message": {
      "type": "string",
      "description": "Latest ISO-8601 timestamp across known message sources."
    },
    "imessage_last_message": {
      "type": "string",
      "description": "Latest iMessage/SMS timestamp if known."
    },
    "whatsapp_last_message": {
      "type": "string",
      "description": "Latest WhatsApp timestamp if known."
    }
  },
  "additionalProperties": true,
  "x-csv-header": [
    "phone",
    "name",
    "source",
    "is_in_group_chats",
    "group_names",
    "message_count",
    "imessage_message_count",
    "whatsapp_message_count",
    "last_message",
    "imessage_last_message",
    "whatsapp_last_message"
  ],
  "x-common-legacy-mappings": {
    "phone_e164": "phone",
    "phone_number": "phone",
    "primary_phone": "phone",
    "display_name": "name",
    "full_name": "name",
    "real_name": "name",
    "total_messages": "message_count",
    "imessage_messages": "imessage_message_count",
    "imessage_count": "imessage_message_count",
    "whatsapp_messages": "whatsapp_message_count",
    "whatsapp_count": "whatsapp_message_count",
    "message_source": "source",
    "source_channel": "source"
  }
}
