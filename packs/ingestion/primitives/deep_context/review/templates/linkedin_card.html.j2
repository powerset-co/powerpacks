{% import '_components.html.j2' as ui with context -%}
<article class='decision-card identity-card' data-card data-parent='{{ parent.slug }}'>
  {{ ui.person_menu(candidates[0].row_key, parent.slug) }}
  {% set body -%}
  {% if failure_note %}<div class='reresearch-failed'>Re-research failed: {{ failure_note }}</div>{% endif %}
  <h2>Check LinkedIn</h2>
  <ul class='linkedin-options'>
    {%- for candidate in candidates %}
    <li class='linkedin-option'>
      {{ ui.profile(parent, candidate, true) }}
      <div class='binary-actions'>
        <button data-decide='detach' data-pub='{{ candidate.row_key }}' data-parent='{{ parent.slug }}'>No</button>
        <button data-decide='keep' data-pub='{{ candidate.row_key }}' data-parent='{{ parent.slug }}'>Yes</button>
      </div>
    </li>
    {%- endfor %}
  </ul>
  {%- endset %}
  {{ ui.scroll_region(body) }}
  <div class='identity-decision'>
    <div class='question'>Is this the right profile? Or <button type='button' class='skip-link' data-open-skip>Skip</button>?</div>
    <button type='button' class='button button-outline' data-open-guidance
            aria-expanded='false'>None of these</button>
    {{ ui.guidance_form(candidates[0], parent.slug) }}
  </div>
</article>
