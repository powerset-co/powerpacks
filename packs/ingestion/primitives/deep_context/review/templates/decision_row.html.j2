{% import '_components.html.j2' as ui with context -%}
{%- set name = parent.name or 'This person' -%}
{%- if parent.worth_row.human -%}
{%- set reason = parent.worth_row.human.note or ('You said ' ~ (parent.worth_row.effective if parent.worth_row.effective in ('yes','no') else 'maybe')) -%}
{%- else -%}
{%- set machine = parent.worth_row.machine.reason or '' -%}
{%- set reason = (machine[:140] ~ ('…' if machine|length > 140 else '')) or ('Worth adding' if target == 'no' else 'Not worth adding') -%}
{%- endif -%}
{%- set flip_label = 'No' if target == 'no' else 'Yes' -%}
<details class='decision-row' data-card data-slug='{{ parent.slug }}'>
  <summary class='decision-row-summary'>
    <span class='decision-row-caret' aria-hidden='true'></span>
    {{ ui.avatar(parent, primary_candidate(parent)) }}
    <div class='decision-row-main'><div class='person-name-line'><strong>{{ name }}</strong>{{ label_badges(parent, show_scores=false) }}</div></div>
    <div class='decision-row-actions'>
      <button class='button button-ghost' data-worth='{{ target }}' data-pub='{{ parent.worth_row.key }}'
              data-parent='{{ parent.slug }}' aria-label='Mark {{ name }} {{ flip_label }}'>{{ flip_label }}</button>
    </div>
  </summary>
  <div class='decision-row-detail'>
    <div class='decision-expanded-profile'><h2>{{ name }}</h2>{{ label_badges(parent, show_scores=false) }}</div>
    <dl class='row-facts'>
      {%- set contacts = candidate_contacts(primary_candidate(parent)) if primary_candidate(parent) else '' %}
      {%- if contacts %}
      <div><dt>Contact</dt><dd>{{ contacts }}</dd></div>
      {%- endif %}
      <div><dt>Why {{ 'yes' if target == 'no' else 'no' }}</dt><dd>{{ reason }}</dd></div>
    </dl>
    <h4 class='dossier-heading'>Who they are</h4>
    <dl class='row-facts dossier-text' data-slug='{{ parent.slug }}' aria-busy='true'></dl>
    <button class='scroll-cue' type='button' data-scroll-cue aria-label='Scroll down' hidden>&#8964;</button>
  </div>
</details>
